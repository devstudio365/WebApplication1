@page
@model WebApplication1.Pages.ProductsModel
@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.ProductID</td>
                <td>@product.ProductName</td>
            </tr>
        }
    </tbody>
</table>
